OPENAI_API_KEY=sk-...
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=allochef-recipes
PINECONE_SUBS_INDEX_NAME=allochef-substitutions
NEO4J_URI=..
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=...

# Nebius Token Factory — used for grocery item normalization in Week 3
# Get your key at https://studio.nebius.ai
NEBIUS_API_KEY=...
# Optional overrides (defaults shown):
# NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
# NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Substitution agent tuning (defaults shown). The selection agent gets a stronger
# model + a little creativity; the allergen safety check stays cheap & deterministic.
# SUBSTITUTION_AGENT_MODEL=gpt-4o
# SUBSTITUTION_AGENT_TEMPERATURE=0.4
# SUBSTITUTION_SAFETY_MODEL=gpt-4o-mini

# Cart backend: "mock" (default — no account needed) or "instacart" (real MCP)
CART_PROVIDER=mock

# Instacart Developer Platform — hosted MCP server for grocery cart (Week 3)
# Only used when CART_PROVIDER=instacart. Creates a shoppable Instacart page.
# Get a key at https://docs.instacart.com/developer_platform_api
INSTACART_API_KEY=...
# Default is the dev MCP endpoint. Switch to prod when ready:
#   dev : https://mcp.dev.instacart.tools/mcp
#   prod: https://mcp.instacart.com/mcp
# INSTACART_MCP_URL=https://mcp.dev.instacart.tools/mcp



